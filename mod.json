{
	"geode": "5.0.0",
	"gd": { "win": "2.2081", "android": "2.2081", "mac": "2.2081", "ios": "2.2081" },
	"id": "roblox.wave-assist",
	"name": "Wave Assist",
	"version": "v3.0.0",
	"developer": "Roblox",
	"description": "Wave and ship auto-pilot that rescues you in tight or deadly sections, plus cube orb auto-click on real orbs only.",
	"tags": ["gameplay", "utility"],
	"settings": {
		"enabled": { "name": "Enable assist", "description": "Master switch.", "type": "bool", "default": true },
		"wave": { "name": "Assist wave", "type": "bool", "default": true },
		"ship": { "name": "Assist ship", "type": "bool", "default": true },
		"cube-orbs": { "name": "Auto-click real orbs", "description": "Cube, ball, UFO, robot, spider, swing. Dash orbs are skipped.", "type": "bool", "default": true },
		"rescue": { "name": "Rescue mode", "description": "Take over the moment your input would lead to death, even in wide corridors.", "type": "bool", "default": true },
		"wave-gap": {
			"name": "Wave: tight if gap under (units)", "description": "30 units = 1 block.",
			"type": "float", "default": 120.0, "min": 60.0, "max": 300.0, "control": { "slider": true, "input": true }
		},
		"ship-gap": {
			"name": "Ship: tight if gap under (units)", "description": "30 units = 1 block.",
			"type": "float", "default": 150.0, "min": 80.0, "max": 400.0, "control": { "slider": true, "input": true }
		},
		"lookahead": {
			"name": "Lookahead (s)", "description": "How far ahead it plans. Higher = safer but more CPU.",
			"type": "float", "default": 0.55, "min": 0.2, "max": 1.2, "control": { "slider": true, "input": true }
		},
		"wave-margin": {
			"name": "Wave safety margin (units)", "description": "Extra space kept around hazards.",
			"type": "float", "default": 2.5, "min": 0.0, "max": 12.0, "control": { "slider": true, "input": true }
		},
		"ship-margin": {
			"name": "Ship safety margin (units)", "description": "Extra space kept around hazards.",
			"type": "float", "default": 4.0, "min": 0.0, "max": 16.0, "control": { "slider": true, "input": true }
		},
		"orb-delay": {
			"name": "Orb click delay (ticks)", "description": "Ticks to wait after touching an orb before clicking.",
			"type": "int", "default": 0, "min": 0, "max": 6, "control": { "slider": true, "input": true }
		},
		"hold-time": {
			"name": "Keep assist on after danger (s)", "description": "Stops it handing control back too early.",
			"type": "float", "default": 0.3, "min": 0.05, "max": 1.0, "control": { "slider": true, "input": true }
		},
		"practice-only": { "name": "Practice / test mode only", "type": "bool", "default": true },
		"player2": { "name": "Assist player 2 (dual)", "type": "bool", "default": true }
	}
}
