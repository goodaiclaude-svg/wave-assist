  "adaptive":        { "type": "bool",  "name": "Adaptive window", "default": true },
  "ship-assist":     { "type": "bool",  "name": "Ship assist", "default": true },
  "ufo-assist":      { "type": "bool",  "name": "UFO assist", "default": true },
  "wave-assist":     { "type": "bool",  "name": "Wave assist", "default": true },
  "pulse-guard":     { "type": "bool",  "name": "Pulse guard (ship/UFO/wave)", "default": true },
  "fly-ring-buffer": { "type": "bool",  "name": "Ring buffer in ship/UFO", "default": true },
  "window-ms":       { "type": "float", "name": "Base buffer (ms)", "default": 90, "min": 0, "max": 300, "control": { "slider": true } },
  "max-window-ms":   { "type": "float", "name": "Max buffer (ms)", "default": 180, "min": 30, "max": 400, "control": { "slider": true } },
  "coyote-ms":       { "type": "float", "name": "Coyote time (ms)", "default": 45, "min": 0, "max": 150, "control": { "slider": true } },
