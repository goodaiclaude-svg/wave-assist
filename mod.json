{
	"geode": "5.0.0",
	"gd": { "win": "2.2081", "android": "2.2081", "mac": "2.2081", "ios": "2.2081" },
	"id": "roblox.wave-assist",
	"name": "Wave Assist",
	"version": "v2.0.0",
	"developer": "Roblox",
	"description": "You steer freely. In tight or closed wave and ship corridors, an auto-pilot plans a safe path and takes over until you are clear.",
	"tags": ["gameplay", "utility"],
	"settings": {
		"enabled": { "name": "Enable assist", "description": "Master switch.", "type": "bool", "default": true },
		"wave": { "name": "Assist wave", "description": "Auto-pilot tight wave corridors.", "type": "bool", "default": true },
		"ship": { "name": "Assist ship", "description": "Auto-pilot tight ship corridors.", "type": "bool", "default": true },
		"wave-gap": {
			"name": "Wave: tight if gap under (units)", "description": "30 units = 1 block. 120 = 4 blocks.",
			"type": "float", "default": 120.0, "min": 60.0, "max": 300.0, "control": { "slider": true, "input": true }
		},
		"ship-gap": {
			"name": "Ship: tight if gap under (units)", "description": "30 units = 1 block. 150 = 5 blocks.",
			"type": "float", "default": 150.0, "min": 80.0, "max": 400.0, "control": { "slider": true, "input": true }
		},
		"hold-time": {
			"name": "Keep assist on after corridor (s)", "description": "Stops it handing control back too early.",
			"type": "float", "default": 0.3, "min": 0.05, "max": 1.0, "control": { "slider": true, "input": true }
		},
		"practice-only": { "name": "Practice / test mode only", "description": "Assist only in practice or test mode.", "type": "bool", "default": true },
		"player2": { "name": "Assist player 2 (dual)", "description": "Also assist the second player.", "type": "bool", "default": true }
	}
}
